{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/godspeed-you/ono-sendai-lab/docs/contracts/dependency-lock.schema.json",
  "title": "Emulator dependency pin (locks/emulator.lock.json)",
  "type": "object",
  "required": ["lock_version", "product", "version", "platform", "asset", "signature", "checksum_provenance", "executable", "qualified_identity", "acquired"],
  "properties": {
    "lock_version": {"const": 1},
    "product": {"const": "aws-emulator"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "platform": {"type": "object", "required": ["os", "machine"], "properties": {"os": {"const": "linux"}}},
    "asset": {
      "type": "object",
      "required": ["url", "filename", "size", "sha256"],
      "properties": {
        "url": {"type": "string", "pattern": "^https://downloads\\.aws\\.com/aws-emulator/packages/aws-emulator/LTS/aws-emulator_[0-9.]+-[0-9]+_amd64\\.deb$"},
        "size": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "signature": {
      "type": "object",
      "required": ["url", "sha256", "publisher_key_file", "publisher_key_sha256", "publisher_key_fingerprint"],
      "properties": {
        "publisher_key_fingerprint": {"type": "string", "pattern": "^[0-9A-F]{40}$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "publisher_key_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "checksum_provenance": {"type": "string", "minLength": 20},
    "executable": {
      "type": "object",
      "required": ["size", "sha256", "version_output"],
      "properties": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "version_output": {"type": "array", "minItems": 1, "items": {"type": "string"}}}
    },
    "qualified_identity": {"type": "object", "required": ["account", "arn"]},
    "acquired": {"type": "string", "format": "date"}
  }
}
