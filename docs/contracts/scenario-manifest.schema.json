{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/godspeed-you/ono-sendai-lab/docs/contracts/scenario-manifest.schema.json",
  "title": "Scenario manifest (scenarios/*.json)",
  "description": "Synthetic, deterministic input. Logical ids and names are stable; AWS-assigned ids are observed per generation and recorded as the logical-to-actual mapping.",
  "type": "object",
  "required": ["schema_version", "id", "version", "description", "requires", "resources", "relations", "verification"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "id": {"enum": ["aws-empty", "aws-minimal"]},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "description": {"type": "string"},
    "requires": {
      "type": "object",
      "required": ["operations"],
      "additionalProperties": false,
      "properties": {"operations": {"type": "array", "items": {"type": "string", "pattern": "^(sts|s3|ec2) [a-z-]+$"}, "uniqueItems": true}}
    },
    "resources": {"type": "array", "items": {"$ref": "#/$defs/resource"}},
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "kind"],
        "additionalProperties": false,
        "properties": {"from": {"type": "string"}, "to": {"type": "string"}, "kind": {"enum": ["subnet-in-vpc", "security-group-in-vpc"]}}
      }
    },
    "verification": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "tags": {"type": "object", "propertyNames": {"pattern": "^[A-Za-z0-9._:/ -]{1,64}$"}, "additionalProperties": {"type": "string", "maxLength": 128}},
    "resource": {
      "type": "object",
      "required": ["logical_id", "type"],
      "properties": {
        "logical_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$"},
        "type": {"enum": ["s3-bucket", "ec2-vpc", "ec2-subnet", "ec2-security-group"]},
        "tags": {"$ref": "#/$defs/tags"}
      },
      "allOf": [
        {"if": {"properties": {"type": {"const": "s3-bucket"}}}, "then": {"required": ["name_template"], "properties": {"name_template": {"type": "string", "pattern": "^[a-z0-9-]+\\{generation12\\}$"}}}},
        {"if": {"properties": {"type": {"const": "ec2-vpc"}}}, "then": {"required": ["cidr"]}},
        {"if": {"properties": {"type": {"const": "ec2-subnet"}}}, "then": {"required": ["cidr", "vpc"]}},
        {"if": {"properties": {"type": {"const": "ec2-security-group"}}}, "then": {"required": ["vpc", "group_name", "description"]}}
      ]
    }
  }
}
